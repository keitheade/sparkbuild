# =============================================================================
# SPARKSOC — agent harness configuration (management VM)
# Copy to .env, chmod 600.
#
# Secrets do NOT live here. They go in ./secrets/ as individual files, mounted
# as Docker secrets. See docs/04-HARNESS-DEPLOY.md.
# =============================================================================

SPARKSOC_ENV=production
LOG_LEVEL=INFO
HARNESS_IMAGE=sparksoc/harness:1.0.0
REDIS_IMAGE=redis:7.4-alpine
BIND_ADDR=0.0.0.0

# --- Spark 1 (fast path) -----------------------------------------------------
TRIAGE_URL=http://10.90.1.11:8001/v1
TRIAGE_MODEL=soc-triage
# Below Spark 1's --max-num-seqs 16, so the harness queue is the visible one.
TRIAGE_CONCURRENCY=8
TRIAGE_TIMEOUT=120

EMBED_URL=http://10.90.1.11:8002/v1
EMBED_MODEL=soc-embed

QDRANT_URL=http://10.90.1.11:6333
QDRANT_COLLECTION=attack_enterprise
RAG_TOP_K=12
RAG_TECHNIQUES=8

# --- Spark 2 (deep path) -----------------------------------------------------
REASON_URL=http://10.90.1.12:8003/v1
REASON_MODEL=soc-reason
# Below Spark 2's --max-num-seqs 4 on purpose. Backpressure should be visible in
# harness metrics, not buried in the vLLM scheduler queue.
REASON_CONCURRENCY=2
# A 6-turn reasoning loop with evidence collection can legitimately run long.
REASON_TIMEOUT=900

# --- Splunk SOAR -------------------------------------------------------------
SOAR_URL=https://10.90.1.20
SOAR_LABEL=events
SOAR_CA_BUNDLE=/etc/sparksoc/soar-ca.pem
SOAR_TIMEOUT=60
SOAR_POLL_TIMEOUT=300
# Host path bind-mounted as the SOAR CA bundle. Must exist. See certs/README.md.
# For plain HTTP to SOAR: SOAR_CA_HOST_PATH=/dev/null and SOAR_CA_BUNDLE=false
SOAR_CA_HOST_PATH=./certs/soar-ca.pem

# --- Pipeline ----------------------------------------------------------------
WORKERS=6
DEEP_WORKERS=2
QUEUE_MAX_SIZE=512
DEEP_QUEUE_MAX_SIZE=128
# Triage threat_score at or above this engages the deep path.
# Lower it to catch more; raise it if Spark 2 is the bottleneck during exercises.
DEEP_THRESHOLD=0.45
DEEP_MAX_TURNS=6
CASE_RETENTION_HOURS=168
# Suppress an identical alert fingerprint for this long. Splunk correlations
# re-fire on their schedule; without this you get a new case every interval.
DEDUPE_TTL_SECONDS=900

# --- Inbound auth ------------------------------------------------------------
HMAC_WINDOW_SECONDS=300
# Restrict to the Splunk search head(s). Empty means any source may POST,
# which is only acceptable if the network path is genuinely restricted.
ALLOWED_SOURCE_IPS=10.90.1.30,10.90.1.31

# Fallback endpoint for Splunk's stock webhook (cannot sign). Leave EMPTY to
# disable. Only enable if you cannot install TA-soc-harness on the search head.
WEBHOOK_FALLBACK_TOKEN=

# --- Actions -----------------------------------------------------------------
# Overrides policy.dry_run in the allowlist. Set true for initial rollout:
# every action is recorded as would-have-executed, nothing dispatches.
FORCE_DRY_RUN=false
