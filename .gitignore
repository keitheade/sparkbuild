staging/work/
*.tar
*.tar.gz
*.part[0-9][0-9][0-9]
MANIFEST.json
MANIFEST.txt

# ---- reports and logs ----
*.log
validation-*.json
baseline-*.json
replay-*.html
replay-*.json
exercise-report.*

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

