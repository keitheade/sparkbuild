# =============================================================================
# SPARKSOC — DGX Spark 1 configuration
# Copy to .env and edit.  chmod 600 .env  — it holds API keys.
# =============================================================================

# --- Images (must match MANIFEST.json digests after docker load) -------------
VLLM_IMAGE=vllm/vllm-openai:cu130-nightly
QDRANT_IMAGE=qdrant/qdrant:v1.12.4

# --- Model locations on the Spark filesystem ---------------------------------
MODEL_ROOT=/opt/sparksoc/models
TRIAGE_MODEL_DIR=Qwen3.5-35B-A3B
EMBED_MODEL_DIR=Qwen3-Embedding-0.6B

# --- Auth --------------------------------------------------------------------
# Generate:  openssl rand -hex 32
VLLM_API_KEY=CHANGEME_openssl_rand_hex_32
QDRANT_API_KEY=CHANGEME_openssl_rand_hex_32

# Bind to the enclave management interface, not 0.0.0.0, once you know the IP.
BIND_ADDR=0.0.0.0

# =============================================================================
# MEMORY BUDGET — read docs/00-ARCHITECTURE.md section 2 before changing
#
#   GPU_UTIL_TRIAGE + GPU_UTIL_EMBED must be <= 0.80.
#   These are independent reservations against ONE 128 GB unified pool.
#   init.sh refuses to start if the sum exceeds the ceiling.
# =============================================================================
GPU_UTIL_TRIAGE=0.62
GPU_UTIL_EMBED=0.04

# =============================================================================
# QUANTIZATION — the single most likely thing to need adjustment
#
# PRIMARY (default): online MXFP4 quantization of the BF16 MoE checkpoint.
#   ~20 GB resident, ~70 tok/s on GB10. Requires working MXFP4 MoE kernels
#   for sm_121 in the image. This is what the smoke gate validates.
TRIAGE_QUANT_ARGS=--quantization mxfp4

# FALLBACK A — if MXFP4 kernels are missing or produce garbage, serve BF16.
#   ~70 GB resident, slower, but depends on no exotic kernel path.
#   Uncomment BOTH lines and comment the PRIMARY line above.
# TRIAGE_QUANT_ARGS=
# GPU_UTIL_TRIAGE=0.75

# FALLBACK B — if an FP8 checkpoint of this model is staged instead, pass
#   NOTHING here. vLLM reads quantization_config from config.json. Passing
#   --quantization fp8 on a pre-quantized checkpoint forces the online path
#   and will fight the checkpoint.
# TRIAGE_QUANT_ARGS=

# --- Context and concurrency -------------------------------------------------
# 32K is ample for alert triage; larger contexts cost KV cache you need for
# concurrency. Raise only if you start feeding full PCAP/EVTX transcripts.
TRIAGE_MAX_LEN=32768

# DO NOT set this to 128. GB10 decode is LPDDR5x bandwidth-bound; past roughly
# 4 concurrent decode streams the per-token bandwidth tax exceeds the batching
# gain. 16 is a deliberate compromise for short structured triage outputs where
# prefill dominates. Measure with validate/bench.py before changing.
TRIAGE_MAX_SEQS=16

TRIAGE_KV_DTYPE=fp8
TRIAGE_LOAD_FORMAT=fastsafetensors

EMBED_MAX_LEN=8192
EMBED_MAX_SEQS=32

# =============================================================================
# sm_121 ESCAPE HATCHES
# Leave at defaults. Change only if the smoke gate or init.sh flags a problem.
# =============================================================================

# Route MXFP4 MoE through FlashInfer with BF16 accumulation instead of Marlin.
# Set to 1 if you see empty completions or garbled output (vLLM #37030).
VLLM_USE_FLASHINFER_MOE_MXFP4_BF16=0

# Force a specific attention backend if the default fails to compile on sm_121.
# Leave empty for auto. Candidates: FLASHINFER, FLASH_ATTN, TRITON_ATTN, XFORMERS
VLLM_ATTENTION_BACKEND=

VLLM_LOG_LEVEL=INFO

# =============================================================================
# ATT&CK ingestion (used by attack_ingest.py)
# =============================================================================
ATTACK_STIX_PATH=/opt/sparksoc/attack/enterprise-attack.json
QDRANT_COLLECTION=attack_enterprise
EMBED_ENDPOINT=http://127.0.0.1:8002/v1
EMBED_MODEL_NAME=soc-embed
# Qwen3-Embedding-0.6B emits 1024 dims. init.sh verifies this at runtime rather
# than trusting the constant.
EMBED_DIM=1024
