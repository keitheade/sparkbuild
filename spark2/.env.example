# =============================================================================
# SPARKSOC — DGX Spark 2 configuration (deep reasoning node)
# Copy to .env, chmod 600.
# =============================================================================

VLLM_IMAGE=vllm/vllm-openai:cu130-nightly

MODEL_ROOT=/opt/sparksoc/models
REASON_MODEL_DIR=gpt-oss-120b

# Must match the VLLM_API_KEY the harness uses. openssl rand -hex 32
VLLM_API_KEY=CHANGEME_openssl_rand_hex_32

BIND_ADDR=0.0.0.0

# =============================================================================
# MEMORY
# Sole workload on this node. ~63 GB MXFP4 weights + KV for 128K context.
# 0.88 of ~119 GB usable leaves ~14 GB for the OS and Docker. Do not exceed
# 0.90 — CUDA graph capture spikes outside the pool vLLM reserves.
# =============================================================================
GPU_UTIL_REASON=0.88

# =============================================================================
# QUANTIZATION
# gpt-oss-120b ships MXFP4 MoE weights natively. Passing --quantization mxfp4
# selects the MXFP4 execution path explicitly.
# =============================================================================
REASON_QUANT_ARGS=--quantization mxfp4

# FALLBACK — if MXFP4 kernels are unusable on this image, there is no BF16
# fallback that fits: gpt-oss-120b in BF16 is ~240 GB. Your options are
# (a) fix the image (docs/01-STAGING.md section 7), or
# (b) temporarily run the triage model on this node too and accept a shallower
#     deep path. There is no third option on 128 GB.

# =============================================================================
# CONTEXT AND CONCURRENCY
#
# max-num-seqs 4 is deliberate and should not be raised. GB10 decode is
# LPDDR5x bandwidth-bound; admitting more concurrent decode streams makes every
# request slower without increasing aggregate throughput. The harness enforces
# a semaphore of 2 on top of this so backpressure is visible in harness metrics
# rather than buried in the vLLM queue.
# =============================================================================
REASON_MAX_LEN=131072
REASON_MAX_SEQS=4
REASON_KV_DTYPE=fp8
REASON_LOAD_FORMAT=fastsafetensors

# =============================================================================
# HARMONY / REASONING PARSER
#
# gpt-oss uses the Harmony response format with separate analysis and final
# channels. The parser name has changed across vLLM releases. Verify with:
#   docker run --rm --entrypoint vllm $VLLM_IMAGE serve --help | grep -A20 reasoning-parser
#
# Known candidates: openai_gptoss, gpt_oss, openai
# If the parser name is wrong vLLM fails at startup with a clear error, so this
# is a fast thing to correct.
# =============================================================================
REASON_PARSER_ARGS=--reasoning-parser openai_gptoss
REASON_TOOL_ARGS=--enable-auto-tool-choice --tool-call-parser openai

# To disable reasoning/tool parsing entirely (raw Harmony passthrough — the
# harness can parse channels itself as a fallback):
# REASON_PARSER_ARGS=
# REASON_TOOL_ARGS=

# =============================================================================
# sm_121 ESCAPE HATCHES — vLLM #37030
#
# Symptom: HTTP 200, finish_reason "stop", and content is empty or null.
# This is a shared-memory race in the Marlin MoE 256-thread kernel on SM121,
# not a prompt problem. init.sh detects it.
#
# Try in this order, restarting between each:
#   1. VLLM_USE_FLASHINFER_MOE_MXFP4_BF16=1   (route MoE via FlashInfer)
#   2. VLLM_MARLIN_USE_ATOMIC_ADD=1           (serialise the racing reduction)
#   3. VLLM_ATTENTION_BACKEND=FLASH_ATTN      (if the fault is in attention)
# =============================================================================
VLLM_USE_FLASHINFER_MOE_MXFP4_BF16=0
VLLM_MARLIN_USE_ATOMIC_ADD=0
VLLM_ATTENTION_BACKEND=

VLLM_LOG_LEVEL=INFO
